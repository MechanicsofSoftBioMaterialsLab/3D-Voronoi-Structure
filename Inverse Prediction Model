@torch.no_grad()
def quick_sample_new(n_sample=8, device="cuda:0", img_size=32, guide_w=0.5):
    model = ContextUnet(in_channels=1, img_size=img_size, n_feat=128, n_classes=11)
    ddpm = DDPM(model, betas=(1e-4, 0.02), n_T=1000, device=device, drop_prob=0.1)
    ddpm.load_state_dict(torch.load(os.path.join(SAVE_DIR, "best_model_3D.pth"), map_location=device))
    ddpm.to(device)
    ddpm = ddpm.to(memory_format=torch.channels_last)  # 2-d
    ddpm.eval()

    dset = VoronoiNewDataset(STRUCT_DIR, RF_DIR, image_size=(img_size, img_size), train_ratio=1.0, training=True, shuffle=True)
    idx = torch.randint(0, len(dset), (n_sample,))
    cond = torch.stack([dset[i][1].squeeze(0) for i in idx], dim=0).to(device)  # (N,11)

    x_i = torch.randn(n_sample, 1, img_size, img_size, device=device).to(memory_format=torch.channels_last)

    c_i = cond.repeat(2, 1).unsqueeze(1)  # (2N,1,11)
    context_mask = torch.zeros(c_i.shape[0], device=device)
    context_mask[n_sample:] = 1.0

    for i in range(ddpm.n_T, 0, -1):
        t_is = torch.full((n_sample, 1, 1, 1), i / ddpm.n_T, device=device)
        x_i = x_i.repeat(2, 1, 1, 1)
        t_is = t_is.repeat(2, 1, 1, 1)
        z = torch.randn_like(x_i[:n_sample]) if i > 1 else 0

        eps = ddpm.nn_model(x_i, c_i, t_is, context_mask)
        eps1, eps2 = eps[:n_sample], eps[n_sample:]
        eps = (1 + guide_w) * eps2 - guide_w * eps1
        x_i = x_i[:n_sample]
        x_i = ddpm.oneover_sqrta[i] * (x_i - eps * ddpm.mab_over_sqrtmab[i]) + ddpm.sqrt_beta_t[i] * z

    grid = make_grid(x_i.clamp(0, 1), nrow=n_sample)
    save_image(grid, os.path.join(SAVE_DIR, f"Sampling_new_w{guide_w}.png"))
    print("Saved sampler grid.")

