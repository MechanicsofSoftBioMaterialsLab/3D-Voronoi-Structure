# ---- robust (un)compiled checkpoint I/O ----
def _strip_num_batches(sd: dict) -> dict:
    return {k: v for k, v in sd.items() if not k.endswith("num_batches_tracked")}

def _remap_compiled_keys(sd: dict) -> dict:
    # remove any "._orig_mod." introduced by torch.compile
    new = {}
    for k, v in sd.items():
        nk = k.replace("nn_model._orig_mod.", "nn_model.")
        nk = nk.replace("._orig_mod.", ".")
        new[nk] = v
    return new

def smart_load_ddpm(ddpm, ckpt_path, map_location="cpu", strict=True):
    sd = torch.load(ckpt_path, map_location=map_location)
    try:
        ddpm.load_state_dict(sd, strict=strict)
        return
    except RuntimeError:
        # try again after remapping compiled keys and dropping BN trackers
        sd2 = _strip_num_batches(_remap_compiled_keys(sd))
        ddpm.load_state_dict(sd2, strict=False)

def save_ddpm_unwrapped(ddpm, path: str):
    """
    Save a state_dict without compile wrappers so it loads on both
    compiled & uncompiled models.
    """
    if hasattr(ddpm.nn_model, "_orig_mod"):
        # temporarily unwrap to get clean keys
        wrapped = ddpm.nn_model
        ddpm.nn_model = wrapped._orig_mod
        sd = ddpm.state_dict()
        ddpm.nn_model = wrapped
    else:
        sd = ddpm.state_dict()
    sd = _strip_num_batches(_remap_compiled_keys(sd))
    torch.save(sd, path)

