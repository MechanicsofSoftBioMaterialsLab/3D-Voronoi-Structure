import re

@torch.no_grad()
def export_test_set_predictions_full(
    guide_w: float = 0.5,
    n_T: int = 1000,
    img_size: int = 32,
    device: str | None = None,
    model_ckpt: str = os.path.join(SAVE_DIR, "best_model_3D.pth"),
    base_out_dir: str = SAVE_DIR
):
    if device is None:
        device = "cuda:0" if torch.cuda.is_available() else "cpu"

    # Build the *test* split (last 10% after fixed shuffle(seed=0))
    dset_test = VoronoiNewDataset(
        folder_input=STRUCT_DIR,
        folder_label=RF_DIR,
        image_size=(img_size, img_size),
        train_ratio=0.9,
        training=False,   # <-- held-out 10%
        shuffle=True      # deterministic due to random.seed(0) in the dataset
    )
    print(f"[INFO] Test set size: {len(dset_test)} samples")

    # Output dirs
    out_dir_32 = os.path.join(base_out_dir, "Predicted-Structures-npy-32-32")
    out_dir_25 = os.path.join(base_out_dir, "Predicted-Structures-npy-25-3")
    out_dir_txt = os.path.join(base_out_dir, "Predicted-Structures-txt")
    for d in [out_dir_32, out_dir_25, out_dir_txt]:
        Path(d).mkdir(parents=True, exist_ok=True)

    # Load model from checkpoint
    model = ContextUnet(in_channels=1, img_size=img_size, n_feat=128, n_classes=11)
    ddpm  = DDPM(model, betas=(1e-4, 0.02), n_T=n_T, device=device, drop_prob=0.1)
    smart_load_ddpm(ddpm, model_ckpt, map_location=device, strict=True)
    ddpm.to(device).eval()
    ddpm = ddpm.to(memory_format=torch.channels_last)

    for idx in range(len(dset_test)):
        # Get condition (RF) and the paired structure filename
        _, label_tensor, npy_name = dset_test[idx]      # label_tensor: (1,11)
        cond = label_tensor.squeeze(0).to(device)       # (11,)
        stem = Path(npy_name).stem                      # e.g. 'structure-123'
        # Extract numeric id to preserve naming convention
        m = re.search(r"(\d+)$", stem)
        sample_id = int(m.group(1)) if m else idx

        # CFG sampling: make unconditional (mask=0) & conditional (mask=1) pair
        n_sample = 1
        x_i = torch.randn(n_sample, 1, img_size, img_size, device=device).to(memory_format=torch.channels_last)
        c_i = cond.unsqueeze(0).repeat(2, 1).unsqueeze(1)  # (2,1,11)
        context_mask = torch.zeros(2, device=device)
        context_mask[n_sample:] = 1.0  # first = uncond (0), second = cond (1)

        for t in range(ddpm.n_T, 0, -1):
            t_is = torch.full((n_sample, 1, 1, 1), t / ddpm.n_T, device=device)
            x_rep = x_i.repeat(2, 1, 1, 1)
            t_rep = t_is.repeat(2, 1, 1, 1)
            z = torch.randn_like(x_i) if t > 1 else 0

            eps = ddpm.nn_model(x_rep, c_i, t_rep, context_mask)
            eps_uncond, eps_cond = eps[:n_sample], eps[n_sample:]
            eps_guided = (1 + guide_w) * eps_cond - guide_w * eps_uncond

            x_i = ddpm.oneover_sqrta[t] * (x_i - eps_guided * ddpm.mab_over_sqrtmab[t]) + ddpm.sqrt_beta_t[t] * z

        # Post-process:
        #   - full image (32×32) in [0,1]
        #   - crop 25×3 and scale back to [0,50] (inverse of training’s /50 padding)
        img32 = x_i.squeeze(0).squeeze(0).clamp(0, 1).cpu().numpy()     # (32,32), float32
        coords_25x3 = (img32[:25, :3] * 50.0).astype(np.float32)        # (25,3)

        # Save with requested names/locations
        np.save(os.path.join(out_dir_32, f"Predicted-Structure-{sample_id}.npy"), img32.astype(np.float32))
        np.save(os.path.join(out_dir_25, f"Predicted-Structure-{sample_id}.npy"), coords_25x3)
        np.savetxt(os.path.join(out_dir_txt, f"Predicted-Structure-{sample_id}.txt"), coords_25x3, fmt="%.6f")

        print(f"[TEST] {idx+1:03d}/{len(dset_test)} → Predicted-Structure-{sample_id}")

# ──────────────────────────────────────────────────────────────────────────────
# EVALUATE ONE SAMPLE (saves cropped 25x3 TXT)
# ──────────────────────────────────────────────────────────────────────────────
@torch.no_grad()
def evaluate_one_sample(
    sample_idx: int = 0,
    guide_w: float = 0.5,
    n_T: int = 1000,
    img_size: int = 32,
    device: str | None = None,
    out_dir: str = SAVE_DIR,
    model_ckpt: str = os.path.join(SAVE_DIR, "best_model_3D.pth"),
):
    if device is None:
        device = "cuda:0" if torch.cuda.is_available() else "cpu"

    dset = VoronoiNewDataset(
        folder_input=STRUCT_DIR,
        folder_label=RF_DIR,
        image_size=(img_size, img_size),
        train_ratio=1.0,    # use all available samples
        training=True,
        shuffle=False
    )
    assert 0 <= sample_idx < len(dset), f"sample_idx must be in [0, {len(dset)-1}]"

    _, label_tensor, npy_name = dset[sample_idx]          # label_tensor: (1,11)
    cond = label_tensor.squeeze(0).to(device)             # (11,)
    stem = Path(npy_name).stem

    model = ContextUnet(in_channels=1, img_size=img_size, n_feat=128, n_classes=11)
    ddpm  = DDPM(model, betas=(1e-4, 0.02), n_T=n_T, device=device, drop_prob=0.1)
    smart_load_ddpm(ddpm, model_ckpt, map_location=device, strict=True)
    ddpm.to(device)
    ddpm = ddpm.to(memory_format=torch.channels_last)  # 2-d) channels-last
    ddpm.eval()

    # CFG: batch=1 duplicated to 2
    n_sample = 1
    x_i = torch.randn(n_sample, 1, img_size, img_size, device=device).to(memory_format=torch.channels_last)

    c_i = cond.unsqueeze(0)                # (1,11)
    c_i = c_i.repeat(2, 1).unsqueeze(1)    # (2,1,11)
    context_mask = torch.zeros(2, device=device)
    context_mask[n_sample:] = 1.0

    for i in range(ddpm.n_T, 0, -1):
        t_is = torch.full((n_sample, 1, 1, 1), i / ddpm.n_T, device=device)
        x_rep = x_i.repeat(2, 1, 1, 1)
        t_rep = t_is.repeat(2, 1, 1, 1)
        z = torch.randn_like(x_i) if i > 1 else 0

        eps = ddpm.nn_model(x_rep, c_i, t_rep, context_mask)
        eps1, eps2 = eps[:n_sample], eps[n_sample:]
        eps_guided = (1 + guide_w) * eps2 - guide_w * eps1

        x_i = ddpm.oneover_sqrta[i] * (x_i - eps_guided * ddpm.mab_over_sqrtmab[i]) + ddpm.sqrt_beta_t[i] * z

    out_np = x_i.squeeze(0).squeeze(0).clamp(0, 1).cpu().numpy()  # (32,32)
    crop = out_np[:25, :3] * 50.0
    Path(out_dir).mkdir(parents=True, exist_ok=True)
    out_txt = os.path.join(out_dir, f"pred_{stem}_25x3.txt")
    np.savetxt(out_txt, crop, fmt="%.6f")

    print(f"[OK] Saved predicted 25x3 TXT to: {out_txt}")
    return out_txt

# ──────────────────────────────────────────────────────────────────────────────
# TRAINING (with 2-a … 2-g integrated)
# ──────────────────────────────────────────────────────────────────────────────
def train_inverse_design_new(
    n_epoch: int = DEFAULT_EPOCHS,
    batch_size: int = 32,
    n_T: int = 1000,
    device: str = "cuda:0",
    n_classes: int = 11,
    n_feat: int = 128,
    base_lr: float | None = None,   # if None and AUTO_SCALE_LR True → computed
    warm_epochs: int = 10,
    weight_decay: float = 1e-2,
    grad_clip: float = 1.0,
    save_model: bool = True,
    drop_prob: float = 0.2,
    img_size: int = 32
):
    """
    Trains a conditional DDPM:
      input condition = 11-D reaction-force vector
      output image    = 1×32×32 (padded from 25×3)
    """
    # dynamic LR scaling (2-e)
    effective_lr = base_lr
    if AUTO_SCALE_LR:
        # Use linear scaling based on batch_size; default anchor is 32 → BASE_LR_PER_32
        effective_lr = BASE_LR_PER_32 * (batch_size / 32.0) if base_lr is None else base_lr
    else:
        effective_lr = BASE_LR_PER_32 if base_lr is None else base_lr

    # model
    model = ContextUnet(in_channels=1, img_size=img_size, n_feat=n_feat, n_classes=n_classes)
    if USE_TORCH_COMPILE:
        try:
            model = torch.compile(model, mode="default")  # or "reduce-overhead"
        except Exception:
            pass


    ddpm = DDPM(nn_model=model, betas=(1e-4, 0.02), n_T=n_T, device=device, drop_prob=drop_prob).to(device)
    ddpm = ddpm.to(memory_format=torch.channels_last)  # 2-d

    # data
    trainset = VoronoiNewDataset(
        folder_input=STRUCT_DIR,
        folder_label=RF_DIR,
        image_size=(img_size, img_size),
        train_ratio=0.9,
        training=True,
        shuffle=True
    )

    # DataLoader with 2-a options (guard for workers==0)
    dl_kwargs = dict(batch_size=batch_size, shuffle=True, pin_memory=True, num_workers=NUM_WORKERS)
    if NUM_WORKERS > 0:
        dl_kwargs.update(dict(persistent_workers=PERSISTENT_WORKERS, prefetch_factor=PREFETCH_FACTOR))
    traindata = DataLoader(trainset, **dl_kwargs)

    # optimizer & scheduler
    optim = torch.optim.AdamW(ddpm.parameters(), lr=effective_lr, weight_decay=weight_decay, betas=(0.9, 0.95))
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optim, T_max=n_epoch - warm_epochs)

    scaler = torch.cuda.amp.GradScaler(enabled=USE_AMP)  # 2-c

    best_loss, loss_hist = float("inf"), []
    t0 = time.time()

    for ep in range(n_epoch):
        ddpm.train()
        print(f"epoch {ep:03d}")

        # warm-up
        if ep < warm_epochs:
            curr_lr = effective_lr * (ep + 1) / max(1, warm_epochs)
            for pg in optim.param_groups:
                pg["lr"] = curr_lr

        pbar = tqdm(traindata, leave=False)
        ema, per_iter = None, []

        optim.zero_grad(set_to_none=True)
        for it, (x, c, _) in enumerate(pbar, start=1):
            # channels-last tensors (2-d)
            x = x.to(device, non_blocking=True).to(memory_format=torch.channels_last)
            c = c.to(device, non_blocking=True)

            with torch.amp.autocast("cuda", enabled=USE_AMP):  # 2-c
                loss = ddpm(x, c) / ACCUM_STEPS

            scaler.scale(loss).backward()

            if it % ACCUM_STEPS == 0:
                scaler.unscale_(optim)
                torch.nn.utils.clip_grad_norm_(ddpm.parameters(), grad_clip)
                scaler.step(optim)
                scaler.update()
                optim.zero_grad(set_to_none=True)

            cur = loss.item() * ACCUM_STEPS
            ema = cur if ema is None else 0.95 * ema + 0.05 * cur
            pbar.set_description(f"loss: {ema:.4f}")
            per_iter.append(ema)

        loss_ep = float(np.mean(per_iter))
        loss_hist.append(loss_ep)

        if ep >= warm_epochs:
            scheduler.step()

        # save best
        if loss_ep < best_loss:
            best_loss = loss_ep
            Path(SAVE_DIR).mkdir(parents=True, exist_ok=True)
            save_ddpm_unwrapped(ddpm, os.path.join(SAVE_DIR, "best_model_3D.pth"))
            print(f"  ↳ new best - saved to best_model_3D.pth  (loss {best_loss:.4f})")

        if save_model and ep == n_epoch - 1:
            save_ddpm_unwrapped(ddpm, os.path.join(SAVE_DIR, f"model_3D_{ep}.pth"))
            print("  ↳ final model saved")

    print(f"Total training time: {time.time() - t0:.1f} s")

    # loss curve
    plt.figure()
    plt.plot(loss_hist)
    plt.xlabel("Epoch"); plt.ylabel("Loss"); plt.title("Training loss (new case)")
    Path(SAVE_DIR).mkdir(parents=True, exist_ok=True)
    plt.savefig(os.path.join(SAVE_DIR, "3D_loss.png"))
    plt.close()

