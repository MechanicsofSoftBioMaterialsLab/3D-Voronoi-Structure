# DATASET
# ──────────────────────────────────────────────────────────────────────────────
class VoronoiNewDataset(Dataset):
    """
    - Loads NPY structures of shape (25, 3), values in [0,50]
      -> normalize to [0,1] by /50
      -> pad to (32,32) in the top-left corner
    - Loads CSV labels with a single column of length 11
    """
    def __init__(
        self,
        folder_input,
        folder_label,
        image_size=(32, 32),
        exts=('npy',),
        train_ratio=0.9,
        training=True,
        shuffle=True
    ):
        super().__init__()
        self.folder_input = folder_input
        self.folder_csv = folder_label
        self.image_size = image_size

        self.paths_input = []
        for ext in exts:
            self.paths_input.extend(Path(folder_input).glob(f"**/*.{ext}"))
        self.paths_input = natsort.natsorted(self.paths_input)

        self.paths_rxn = natsort.natsorted(Path(folder_label).glob("**/*.csv"))

        assert len(self.paths_input) == len(self.paths_rxn), \
            f"Mismatch: {len(self.paths_input)} structures vs {len(self.paths_rxn)} CSVs."

        if shuffle:
            random.seed(0)
            paired = list(zip(self.paths_input, self.paths_rxn))
            random.shuffle(paired)
            self.paths_input, self.paths_rxn = map(list, zip(*paired))

        self.training = training
        self.train_ratio = train_ratio

        if 0.0 < train_ratio < 1.0:
            n_train = int(len(self.paths_input) * train_ratio)
            if self.training:
                self.paths_input = self.paths_input[:n_train]
                self.paths_rxn   = self.paths_rxn[:n_train]
            else:
                self.paths_input = self.paths_input[n_train:]
                self.paths_rxn   = self.paths_rxn[n_train:]

        self.transform_img = T.Compose([T.ToTensor()])  # (H,W) -> (1,H,W)

    @staticmethod
    def _pad_to_square(x: np.ndarray, target: int = 32) -> np.ndarray:
        H, W = x.shape
        out = np.zeros((target, target), dtype=np.float32)
        out[:H, :W] = x
        return out

    def __len__(self):
        return len(self.paths_input)

    def __getitem__(self, index):
        npy_path = self.paths_input[index]
        csv_path = self.paths_rxn[index]

        arr = np.load(npy_path).astype(np.float32)  # expected shape (25,3)
        assert arr.ndim == 2 and arr.shape == (25, 3), f"Bad shape in {npy_path}: {arr.shape}"
        arr = np.clip(arr, 0.0, 50.0) / 50.0
        img = self._pad_to_square(arr, target=self.image_size[0])  # 32×32

        rf = pd.read_csv(csv_path, header=None).values.squeeze().astype(np.float32)
        assert rf.ndim == 1 and rf.shape[0] == 11, f"CSV {csv_path} must be 11x1"
        label = rf[np.newaxis, :]  # (1,11)

        return self.transform_img(img), torch.from_numpy(label), npy_path.name

